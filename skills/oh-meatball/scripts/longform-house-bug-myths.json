   "tier": "MYTH",
   "danger": 0,
   "lines": [
    {
     "m": "name",
     "say": "Next: daddy longlegs have the deadliest venom, but their fangs are too short to bite you.",
     "card": {
      "rows": [
       [
        "DEADLIEST VENOM?",
        "#ffd34d",
        104
       ],
       [
        "DADDY LONGLEGS",
        "#ffffff",
        46,
        true
       ]
      ],
      "y": 150,
      "at": "30%"
     }
    },
    {
     "m": "escalate",
     "say": "Problem one. Daddy longlegs is three different animals.",
     "scene": "study",
     "scene_p": {
      "time": "night"
     },
     "card": {
      "rows": [
       [
        "3",
