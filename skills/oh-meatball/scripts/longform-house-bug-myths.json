     "m": "fact",
     "say": "Pincers on its rear end, and it loves dark, damp hiding spots.",
     "scene": "garden",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "escalate",
     "say": "So one entomologist went looking for proof. She searched ten centuries of writing.",
     "scene": "study",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "fact",
     "say": "She found one single case.",
     "scene": "study",
