    {
     "m": "fact",
     "say": "It hates light. That's why you almost never see one.",
     "scene": "bedroom",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "fact",
     "say": "The holes are from its babies. Mom lays forty to fifty eggs, right on your wool.",
     "scene": "fibers",
     "card": {
      "rows": [
       [
        "40-50",
        "#ffd34d",
        130
       ],
       [
        "EGGS ON YOUR WOOL",
