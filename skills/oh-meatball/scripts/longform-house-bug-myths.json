   "chapter": "True: fruit flies went to space first",
   "tier": "TRUE",
   "danger": 0,
   "lines": [
    {
     "m": "name",
     "say": "The first animals ever sent into space? Fruit flies.",
     "card": {
      "rows": [
       [
        "FRUIT FLIES",
        "#ffd34d",
        104
       ],
       [
        "FIRST IN SPACE",
        "#ffffff",
        46,
        true
       ]
      ],
      "y": 150,
      "at": "30%"
     }
    },
    {
     "m": "fact",
     "say": "In nineteen forty seven, on a rocket launched in New Mexico.",
     "scene": "study",
     "scene_p": {
      "time": "night"
     },
     "card": {
      "rows": [
       [
        "1947",
        "#ffd34d",
        130
       ],
       [
        "FIRST ANIMALS IN SPACE",
        "#ffffff",
        46,
        true
       ]
      ],
      "y": 120,
      "at": "40%"
     }
    },
    {
     "m": "escalate",
     "say": "The rocket climbed more than sixty miles up.",
     "scene": "study",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "escalate",
     "say": "Before monkeys. Before dogs. Before any human.",
     "scene": "study",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "fact",
     "say": "Monkeys didn't follow until nineteen forty nine.",
     "scene": "study",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "fact",
     "say": "Scientists wanted to know what radiation up there does to living things.",
     "scene": "microscope"
    },
    {
     "m": "fact",
     "say": "The capsule parachuted back down, and the flies came home alive.",
     "scene": "garden",
     "scene_p": {
      "time": "day"
     }
    },
    {
     "m": "fact",
     "say": "So the fly on your banana? It comes from a family of astronauts.",
