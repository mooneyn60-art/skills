       [
        "IN 10 CENTURIES",
        "#ffffff",
        46,
        true
       ]
      ],
      "y": 120,
      "at": "40%"
     }
    },
    {
     "m": "fact",
     "say": "At night, earwigs hunt in the garden. Aphids, insect eggs, and rotting plants.",
     "scene": "garden",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "xray",
     "say": "And the mom guards her eggs, and feeds her babies when they hatch.",
     "scene": "microscope"
    },
    {
     "m": "fact",
     "say": "Most earwigs have wings, folded under short hard covers. But they seldom fly.",
     "scene": "garden",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "calm",
     "say": "They can pinch you, if you grab one. That's about it.",
     "scene": "bathroom",
     "scene_p": {
      "time": "night"
     }
    },
    {
     "m": "fact",
     "say": "Verdict: myth. One case in a thousand years. Your ears are safe.",
     "scene": "bathroom",
     "scene_p": {
      "time": "night"
     },
     "board": {
      "add": true,
