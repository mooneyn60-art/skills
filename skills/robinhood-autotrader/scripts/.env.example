# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- Robinhood credentials (yours, not Claude's) ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# TOTP secret from enabling authenticator-app 2FA in Robinhood settings (the base32
# string shown when you set it up) — NOT a 6-digit code, which expires in seconds.
ROBINHOOD_TOTP_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Execution mode: leave unset/false for paper trading. Only you should set this. ---
LIVE_TRADING=false

# --- Optional overrides (defaults live in config.py) ---
# AUTOTRADER_WATCHLIST=AAPL,MSFT,SPY,QQQ
# AUTOTRADER_MAX_POSITION_USD=2000
# AUTOTRADER_MAX_DAILY_LOSS_FRACTION=0.04
# AUTOTRADER_MAX_POSITION_FRACTION=0.20
# AUTOTRADER_MIN_CONFIDENCE=0.65
# AUTOTRADER_MODEL=claude-sonnet-5
