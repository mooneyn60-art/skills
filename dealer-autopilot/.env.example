# Copy this file to .env and fill it in. Never commit .env.

PORT=3000
# Your public address (needed for email unsubscribe links, the calendar feed, and the claude.ai connector)
PUBLIC_URL=http://localhost:3000
# Password for the dashboard. Always set one if this runs anywhere but your own computer.
APP_PASSWORD=change-me

# ---- Email: your Gmail (or Outlook / dealership mail) ----
# Gmail: turn on 2-Step Verification, then create an App Password at myaccount.google.com/apppasswords
# Leave blank to run email in SIMULATION mode (logged, not sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=

# ---- TARS, the built-in assistant (optional: you can use Claude over MCP instead) ----
ANTHROPIC_API_KEY=

# ---- Only if you switch texting to a business number (Settings > Send texts from) ----
# Requires A2P 10DLC registration with Twilio or texts get blocked.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
